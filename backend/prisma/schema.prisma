generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN
// ============================================================
model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hash
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  notices   Notice[]
  auditLogs AuditLog[]
}

// ============================================================
// EMPLOYEE
// ============================================================
model Employee {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hash, set/reset by admin
  avatarUrl String?
  active    Boolean  @default(true) // soft-disable (Deactivate), never hard-delete by default

  // Duty time override — if null, use global default (see GlobalSettings)
  dutyStartTimeOverride String? // stored as "HH:mm", nullable

  // Tracks the last date (BD calendar date) this employee received a
  // daily duty-time reminder push, so dutyReminderJob never double-sends
  // on the same day (Spec §6.1).
  lastDutyReminderDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  attendanceEvents AttendanceEvent[]
  auditLogsAbout   AuditLog[]        @relation("AuditTargetEmployee")
  pushSubscription PushSubscription?
}

// ============================================================
// SESSION — enforces single-device login (Spec §8.1)
// One row = one active login. Employee/Admin each have at most
// one active Session row at a time; a new login either fails
// with "already active elsewhere" or force-invalidates this row.
// ============================================================
model Session {
  id         String   @id @default(uuid())
  token      String   @unique // JWT id (jti)
  userType   UserType
  employeeId String?
  adminId    String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([adminId])
}

enum UserType {
  EMPLOYEE
  ADMIN
}

// ============================================================
// ATTENDANCE EVENT — the core log. Every state transition is one
// row here. Reports and audit trail are all derived from this.
// (Spec §2, §9)
// ============================================================
model AttendanceEvent {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        EventType    // CHECK_IN, BREAK_START, BREAK_END, CHECK_OUT
  breakReason BreakReason? // only set when type = BREAK_START
  note        String?      // Other-reason note, or checkout note

  // Flags (Spec §4, §5)
  isAutoGenerated Boolean @default(false) // true for system auto-checkout
  isForgotFlag    Boolean @default(false) // "Forgot to check out" marker
  isLunchOverrun  Boolean @default(false) // marks a BREAK_END that exceeded max lunch duration

  // Which "work day" (BD timezone calendar date) this event belongs to —
  // stored explicitly so day-boundary logic doesn't depend on recomputing
  // timezone conversions later (Spec §3).
  workDate DateTime @db.Date

  serverTimestamp DateTime @default(now()) // AUTHORITATIVE time (Spec §3) — never trust client time

  createdAt DateTime @default(now())

  auditLogs AuditLog[]

  @@index([employeeId, workDate])
}

enum EventType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
}

enum BreakReason {
  LUNCH
  OTHER
}

// ============================================================
// HOLIDAY (Spec §7.4)
// ============================================================
model Holiday {
  id        String      @id @default(uuid())
  type      HolidayType
  // For WEEKLY: dayOfWeek is set (0=Sun..6=Sat), startDate/endDate null
  dayOfWeek Int?
  // For CUSTOM: a single date (startDate = endDate) or a range
  title     String?
  startDate DateTime?   @db.Date
  endDate   DateTime?   @db.Date

  createdAt DateTime @default(now())
}

enum HolidayType {
  WEEKLY
  CUSTOM
}

// ============================================================
// NOTICE — admin urgent broadcast (Spec §7.5)
// ============================================================
model Notice {
  id          String   @id @default(uuid())
  title       String
  body        String
  createdBy   String
  admin       Admin    @relation(fields: [createdBy], references: [id])
  publishedAt DateTime @default(now())
  expiresAt   DateTime // publishedAt + admin-chosen duration
  revoked     Boolean  @default(false)

  createdAt DateTime @default(now())
}

// ============================================================
// AUDIT LOG — every manual admin edit (Spec §7.8)
// ============================================================
model AuditLog {
  id      String @id @default(uuid())
  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id])

  employeeId String
  employee   Employee @relation("AuditTargetEmployee", fields: [employeeId], references: [id])

  attendanceEventId String?
  attendanceEvent   AttendanceEvent? @relation(fields: [attendanceEventId], references: [id])

  action      String  // e.g. "EDIT_EVENT_TIME", "CREATE_MANUAL_ENTRY"
  beforeValue String? // JSON string snapshot
  afterValue  String? // JSON string snapshot
  reason      String  // admin's required note for the edit

  createdAt DateTime @default(now())
}

// ============================================================
// GLOBAL SETTINGS — single-row table for tool-wide defaults
// (Spec §7.2, §7.3)
// ============================================================
model GlobalSettings {
  id                      Int      @id @default(1)
  defaultDutyStartTime    String   @default("09:30") // "HH:mm"
  dailyTargetHours        Float    @default(8)
  autoCheckoutBufferHours Float    @default(4)
  lunchMaxMinutes         Int      @default(70)
  updatedAt               DateTime @updatedAt
}

// ============================================================
// PUSH SUBSCRIPTION — browser push endpoint per employee (Spec §6)
// One employee has at most one active subscription, tied to their
// one allowed device/session (Spec §8.1).
// ============================================================
model PushSubscription {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}